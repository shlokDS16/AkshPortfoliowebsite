# =============================================================================
# Aksh Research Desk - environment template
# Copy to .env.local for local dev. Set the same keys in Vercel > Project > Settings
# > Environment Variables. NEVER commit .env.local.
#
# Labels:  [REQUIRED-P1]  needed for Phase 1 (core site)
#          [REQUIRED-P2]  needed for Phase 2 (ingestion)     [REQUIRED-P3] Phase 3 (ledger)
#          [REQUIRED-P5]  needed for Phase 5 (newsletter/video)
#          [OPTIONAL]     feature works without it, degraded
#          [SECRET]       server-only; never expose to the browser (no NEXT_PUBLIC_ prefix)
# =============================================================================

# ----- Site ------------------------------------------------------------------
# [REQUIRED-P1] Canonical URL, no trailing slash. Local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# [REQUIRED-P1] Owner's email; the only account allowed into /admin.
ADMIN_EMAIL=
# [REQUIRED-P1][SECRET] Random 32+ char string. Vercel Cron sends it as
# "Authorization: Bearer <CRON_SECRET>"; the daily job route rejects anything else.
# Generate: openssl rand -hex 32
CRON_SECRET=

# ----- Supabase (database, auth, storage, pgvector) --------------------------
# Get from: https://supabase.com/dashboard/project/<ref>/settings/api
# [REQUIRED-P1] Project URL
NEXT_PUBLIC_SUPABASE_URL=
# [REQUIRED-P1] Publishable (anon) key - safe in the browser, RLS enforces access
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# [REQUIRED-P1][SECRET] Secret key (sb_secret_...) - bypasses RLS. Used ONLY by server jobs
# (ingestion worker, price cron). Never import into client code. Legacy service_role keys retire end-2026.
SUPABASE_SECRET_KEY=
# [OPTIONAL] Direct Postgres URL for migrations/CLI (Settings > Database)
SUPABASE_DB_URL=
# [DEV-ONLY][SECRET] Personal access token (sbp_...) for the Supabase CLI/MCP: `supabase link`,
# `supabase db push`, management API. Full account access. LOCAL ONLY: never add to Vercel,
# never read from app code. Get from: https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=

# ----- Groq (free-tier LLM: structuring, classification, vision, Whisper) ----
# Get from: https://console.groq.com/keys   Free tier: 8k TPM, 200k TPD
# [REQUIRED-P2][SECRET]
GROQ_API_KEY=
# [OPTIONAL] Override default models (see docs/research/2026-10-04-tooling-landscape.md s7)
GROQ_MODEL_TEXT=openai/gpt-oss-120b
GROQ_MODEL_VISION=qwen/qwen3.8-27b
GROQ_MODEL_CLASSIFY=openai/gpt-oss-20b
GROQ_MODEL_WHISPER=whisper-large-v3-turbo
# [OPTIONAL] Voice notes (Plan 2b Task 4) send Aksh's recordings to Groq to be typed out. Leave EMPTY (off) until Aksh
# has agreed (ADR-004 s8); `on` switches it on. Off means the drop bar hides voice notes and nothing is sent.
VOICE_NOTES=
# [DEV-ONLY] fixture for local e2e; never set on Vercel (refused on preview/production: AI reading stays off).
# Values: groq | fixture. Leave empty to use Groq when GROQ_API_KEY is set.
LLM_ADAPTER=

# [OPTIONAL][SECRET] Paid burst capacity later (native PDF reading, skips OCR). Leave empty on free tier.
ANTHROPIC_API_KEY=

# NOTE: also store CRON_SECRET as a GitHub repository secret named CRON_SECRET so
# .github/workflows/pump.yml can call /api/jobs/run every 15 minutes.

# ----- OCR fallback for scanned pages / screenshots --------------------------
# OCR.space (decided 2026-10-06, replaces Azure DI): free = 25,000 requests/month, 500/day per IP,
# 1 MB per file, 3 pages per PDF request. Plain text + word boxes; table layout is weaker than Azure,
# so tables in scans go to Groq vision (qwen) as a second pass. Get from: https://ocr.space/ocrapi/freekey
# Unset means "Scan reading is off": scanned PDF pages wait, nothing else breaks. Sent as the `apikey` header, Engine 2.
# [OPTIONAL][SECRET]
OCRSPACE_API_KEY=
# Google Cloud Vision overflow (1,000 pages/month free). Enable Vision API, create API key.
# [OPTIONAL][SECRET]
GOOGLE_VISION_API_KEY=

# ----- Market data (daily closes for the private ledger) ---------------------
# Decided 2026-10-06: NSE official daily files are the ONLY price source in v1 (no key needed; personal tracking only,
# never republished raw). Upstox dropped (no account). Verified 2026-10-13 (ADR-005 s2): both answer 200 for a trading day.
# The host is fixed in code (nsearchives.nseindia.com, https only): these two change the PATH only, and a value that
# names another host is refused at start-up. Leave EMPTY to use the defaults. Do NOT set them on Vercel.
# [OPTIONAL] Equity file (a zip with one CSV); {YYYYMMDD} is substituted. The old `..._F.csv.zip` pattern returns 404.
NSE_BHAVCOPY_URL_TEMPLATE=https://nsearchives.nseindia.com/content/cm/BhavCopy_NSE_CM_0_0_0_{YYYYMMDD}_F_0000.csv.zip
# [OPTIONAL] Nifty 50 and other index closes (a CSV); {DDMMYYYY} is substituted.
NSE_INDEX_URL_TEMPLATE=https://nsearchives.nseindia.com/content/indices/ind_close_all_{DDMMYYYY}.csv

# ----- Public copy of the ledger's fingerprints (GitHub Gist) ------------------
# OFF by default and that is fine: with either value empty the day's fingerprint line is sealed in the database and waits;
# nothing leaves the database. Switching it on (owner only, decision Q26) publishes ONE line per day to a PUBLIC gist you
# create by hand: a date, the number of ledger entries that day, and their fingerprints (hashes). No names, no words, no
# prices. The waiting lines are published together the first day. GitHub dates the file's changes, which lets a reader who
# saved a line spot later rewriting. It is NOT tamper-proof: the gist's owner can still edit or delete it.
# Create a public gist containing any one file and copy its id (the hex string at the end of its address). The host is
# fixed in code (api.github.com). Do not put either value on Vercel until the owner has agreed.
# [OPTIONAL][SECRET] Fine-grained token, user permission "Gists: write" only (github.com/settings/personal-access-tokens).
GITHUB_GIST_TOKEN=
# [OPTIONAL] The gist's id: 20 to 40 lowercase hex characters, nothing else (it becomes part of an address).
LEDGER_ANCHOR_GIST_ID=

# ----- Email (Resend, free: 3,000 emails/month and 100/day, shared by the 2.9 alert email and the Phase 5c confirmations) ---
# Get from: https://resend.com/api-keys
# [OPTIONAL][SECRET] Alert email (2.9) is OFF until this and ALERT_EMAIL (see Observability) are both set on Vercel Production.
RESEND_API_KEY=
# [OPTIONAL] The "From" line readers see; empty = "Aksh Research Desk <onboarding@resend.dev>". Without a verified domain Resend
# only allows "onboarding@resend.dev" and only delivers to the Resend account owner's own address, so the alert email reaches
# only Shlok until a domain is verified (docs/project-memory/unanswered-questions.md Q36). The newsletter (Phase 5) needs a
# domain (Resend > Domains > add DNS records). e.g. "Aksh Agrawal <desk@akshagrawal.in>"
RESEND_FROM=
# [UNUSED] Superseded by LETTERS_SEGMENT_ID below (Resend renamed Audiences to Segments in 2025). Not read by the app; leave empty.
RESEND_AUDIENCE_ID=

# ----- Letters (Phase 5c: Aksh's own letters to readers who asked and confirmed) ---------------------------------------------
# Letters are OFF until ALL THREE are set, and they send only on Vercel Production (never on a preview, in CI or in a test).
# Even then nothing goes out until Aksh presses "Send" on the desk: every email needs an approval row recorded in the database
# for exactly that send. Off: the desk says "Email is not set up yet. Letters still publish to the archive." and the sign-up form
# is not shown. Before setting them: verify a domain in Resend (Q9/Q36), turn open and click tracking off on it, create a segment.
# [OPTIONAL-P5][SECRET] A FULL-ACCESS Resend key (broadcasts and contacts need it; https://resend.com/api-keys). Keep it separate
# from RESEND_API_KEY above, which stays a sending-only key for the alert email. Do not put it on Vercel until Shlok has agreed.
RESEND_LETTERS_KEY=
# [OPTIONAL-P5] The sender, on the verified domain (never onboarding@resend.dev), e.g. "Aksh Agrawal <letters@akshagrawal.in>".
LETTERS_FROM=
# [OPTIONAL-P5] The id of the Resend segment the letters go to (Resend > Audience > Segments). Created by hand; the app only
# keeps its contacts equal to the confirmed readers.
LETTERS_SEGMENT_ID=

# ----- Video (YouTube unlisted listing + transcripts) ------------------------
# Videos are OFF until BOTH settings are set; nothing is read from YouTube before that, and `v:` captures are still filed.
# The desk only READS YouTube (videos.list, GET, one unit a call of 10,000 a day); it never uploads or changes anything there.
# YouTube Data API v3 key (Google Cloud Console > APIs > Credentials), restricted to "YouTube Data API v3". Read-only.
# [OPTIONAL-P5][SECRET] Do not put it on Vercel until Shlok has agreed.
YOUTUBE_API_KEY=
# [OPTIONAL-P5] Aksh's channel ID (starts with "UC", 24 chars). Find it at
# https://www.youtube.com/account_advanced while signed in to his channel. Leave empty if no channel yet.
YOUTUBE_CHANNEL_ID=
# [DEV-ONLY] `fixture` makes the video and letter adapters answer from memory (or a local file), with no outside call. Refused on
# Vercel preview and production (video listing and letters then stay off). Leave EMPTY everywhere else.
DISTRIBUTION_ADAPTER=

# ----- Observability (all free tiers) ----------------------------------------
# [OPTIONAL] Sentry DSN for error alerts to the owner
SENTRY_DSN=
# [OPTIONAL] Who gets the 2.9 alert email ("something needs a look", then "all clear again"): one address or a comma-separated
# list. Empty = alert email off (ADMIN_EMAIL is NOT a fallback). Until a domain is verified at Resend it must be the Resend
# account's own address; any other address is refused by Resend and the alerts:email step shows red in the heartbeat log.
ALERT_EMAIL=
